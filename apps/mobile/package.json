{
  "name": "@counter/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Counter POS mobile app — React Native + Expo. The register that lives in an apron pocket.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
