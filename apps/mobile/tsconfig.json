{
  "extends": "@counter/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["react"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["app/**/*", "src/**/*", "index.ts", "*.ts", "*.tsx"],
  "exclude": ["node_modules", ".expo", "dist"]
}
