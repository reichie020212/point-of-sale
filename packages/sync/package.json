{
  "name": "@counter/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sync engine — wire protocol types and shared helpers consumed by both apps/api and apps/mobile.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@counter/eslint-config": "workspace:*",
    "@counter/tsconfig": "workspace:*",
    "eslint": "8.57.0",
    "typescript": "5.4.5"
  }
}
