{
  "name": "@counter/printers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Receipt-printer abstraction. Mock + web for W4; BLE thermal stubbed for W5 hardware integration.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@counter/eslint-config": "workspace:*",
    "@counter/tsconfig": "workspace:*",
    "@types/node": "20.12.7",
    "eslint": "8.57.0",
    "tsx": "4.19.2",
    "typescript": "5.4.5"
  }
}
