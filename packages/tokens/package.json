{
  "name": "@counter/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design tokens for Counter POS — colors, type, spacing, radii, shadows. Single source of truth across mobile, web, and marketing.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./variables.css": "./src/web/variables.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/web/variables.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@counter/eslint-config": "workspace:*",
    "@counter/tsconfig": "workspace:*",
    "eslint": "8.57.0",
    "typescript": "5.4.5"
  }
}
