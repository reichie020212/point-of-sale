engine-strict=false
strict-peer-dependencies=false
auto-install-peers=true

# Expo / React Native + pnpm: Metro's resolver does not follow pnpm's
# nested store, so transitive deps (invariant, @babel/runtime, react-native
# internals, etc.) must be visible at the project root. The `*` pattern
# below hoists every package; the workspace ergonomics cost is small at
# this size and the alternative is a long, bit-rotting allowlist.
# https://docs.expo.dev/guides/monorepos/#install-and-configure-workspace
public-hoist-pattern[]=*
shamefully-hoist=true
